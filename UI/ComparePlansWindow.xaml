<Window x:Class="PowerGridHaYTooL.UI.ComparePlansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tüm Güç Düzenlerini Karşılaştır ve Yönet" 
        Height="730" Width="1080" 
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBg}" 
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="12"
        Icon="pack://application:,,,/logo.png">

    <Window.Resources>
        <Style TargetType="{x:Type Button}" x:Key="ModernBtn">
            <Setter Property="Background" Value="{DynamicResource BrushBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushBtnHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushListItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="PrimaryBtn" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#090D16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{DynamicResource BrushBorder}" 
                                BorderThickness="0,0,0,1" 
                                Padding="4,4">
                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushListItemHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Layout Grid -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Toolbar -->
                <RowDefinition Height="*"/>    <!-- Multi-Plan Comparison Matrix -->
                <RowDefinition Height="Auto"/> <!-- Bottom Status & Actions -->
            </Grid.RowDefinitions>

            <!-- Top Header & Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Subtitle -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Background="{DynamicResource BrushAccentGlow}" CornerRadius="6" Padding="8,6" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="⚖️" FontSize="22"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeaderTitle" Text="Tüm Güç Düzenlerini Karşılaştır ve Yönet" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="TxtHeaderSubtitle" Text="Sisteminizdeki tüm güç planlarını yan yana kıyaslayın, farkları inceleyin ve doğrudan bu ekrandan çift tıklayarak düzenleyin." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRefresh" Style="{StaticResource ModernBtn}" Content="🔄 Yenile" Padding="12,5" Click="BtnRefresh_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filters & Search Toolbar -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Search Box -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBox x:Name="TxtSearch" Width="200" Padding="6,4" Background="{DynamicResource BrushBtnBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" TextChanged="TxtSearch_TextChanged"/>
                            </StackPanel>

                            <!-- Center: Category Filter -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <ComboBox x:Name="CmbCategoryFilter" Width="170" SelectionChanged="CmbCategoryFilter_SelectionChanged">
                                    <ComboBoxItem Content="Tüm Kategoriler"/>
                                    <ComboBoxItem Content="İşlemci (CPU)"/>
                                    <ComboBoxItem Content="Ekran &amp; Uyku"/>
                                    <ComboBoxItem Content="Donanım (PCIe/USB/WiFi)"/>
                                    <ComboBoxItem Content="Güç Düğmeleri"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Right: Show Only Differences Toggle -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkOnlyDifferences" Content="Yalnızca Farklı Ayarları Göster" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Multi-Plan Matrix Grid -->
            <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
                <ListView x:Name="LstComparison" 
                          BorderThickness="0" 
                          Background="Transparent" 
                          Foreground="{DynamicResource BrushTextPrimary}" 
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="LstComparison_MouseDoubleClick">
                    <ListView.View>
                        <GridView x:Name="GvComparison"/>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Bottom Action Bar & Status -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusSummary" Text="Planlar yükleniyor..." Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <Button x:Name="BtnQuickEditSelected" Style="{StaticResource ModernBtn}" Content="⚡ Seçili Ayarı Değiştir..." Click="BtnQuickEditSelected_Click" ToolTip="Tabloda seçtiğiniz ayarı doğrudan düzenlemek için tıklayın (veya satıra çift tıklayın)"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnClose" Style="{StaticResource ModernBtn}" Content="Kapat" Width="90" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- In-Place Quick Edit Overlay (Karşılaştırma Ekranı İçi Hızlı Düzenleyici) -->
        <Grid x:Name="OverlayQuickEdit" Visibility="Collapsed" Panel.ZIndex="999">
            <!-- Dim Backdrop -->
            <Border Background="#8A000000" MouseDown="OverlayBackdrop_MouseDown"/>

            <!-- Floating Card -->
            <Border Background="{DynamicResource BrushCardBg}" 
                    BorderBrush="{DynamicResource BrushAccent}" 
                    BorderThickness="1.5" 
                    CornerRadius="10" 
                    Width="480" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Padding="22">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtQuickEditHeader" Text="Karşılaştırma Ekranında Hızlı Ayar Değiştir" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ModernBtn}" Content="✕" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Click="BtnCancelQuickEdit_Click"/>
                    </Grid>

                    <!-- Target Plan Selector -->
                    <TextBlock Text="Değiştirilecek Güç Planı:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbQuickPlan" Margin="0,0,0,12" SelectionChanged="CmbQuickPlan_SelectionChanged"/>

                    <!-- Setting Title -->
                    <TextBlock Text="Düzenlenen Ayar:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtQuickSettingTitle" Text="Ayar Adı" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" FontSize="13"/>
                    </Border>

                    <!-- Interactive Input (Combo vs Slider) -->
                    <!-- 1. ComboBox Editor (Discrete choices) -->
                    <StackPanel x:Name="PanelQuickCombo" Margin="0,0,0,14">
                        <TextBlock Text="Yeni Değer Seçin:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbQuickValue"/>
                    </StackPanel>

                    <!-- 2. Slider Editor (Percentages) -->
                    <StackPanel x:Name="PanelQuickSlider" Margin="0,0,0,14" Visibility="Collapsed">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Yeni Değer Belirleyin:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock x:Name="TxtQuickSliderVal" Text="100%" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SldQuickValue" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldQuickValue_ValueChanged"/>
                    </StackPanel>

                    <!-- Apply to All Plans Option -->
                    <Border Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                        <CheckBox x:Name="ChkApplyToAllPlans" Content="Bu yeni değeri listedeki TÜM güç planlarına aynı anda uygula" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                    </Border>

                    <!-- Actions -->
                    <Grid>
                        <Button Style="{StaticResource ModernBtn}" Content="İptal" Width="90" HorizontalAlignment="Left" Click="BtnCancelQuickEdit_Click"/>
                        <Button Style="{StaticResource PrimaryBtn}" Content="💾 Kaydet ve Hemen Uygula" Padding="18,6" HorizontalAlignment="Right" Click="BtnSaveQuickEdit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
