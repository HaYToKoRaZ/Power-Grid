<Window x:Class="PowerGridHaYTooL.UI.CliHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komut Satırı (CLI) Kılavuzu &amp; Hızlı Kopyalama" 
        Height="640" Width="700" 
        MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBg}" 
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="12"
        Icon="pack://application:,,,/logo.png">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style TargetType="{x:Type Button}" x:Key="ModernBtn">
            <Setter Property="Background" Value="{DynamicResource BrushBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushBtnHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushListItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Copy Action Button (Accent Outline) -->
        <Style TargetType="{x:Type Button}" x:Key="CopyBtn" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Primary Action Button -->
        <Style TargetType="{x:Type Button}" x:Key="PrimaryBtn" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#090D16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Quick Plan Generator -->
            <RowDefinition Height="*"/>    <!-- Commands Scroll List -->
            <RowDefinition Height="Auto"/> <!-- Footer / Close -->
        </Grid.RowDefinitions>

        <!-- 1. Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="💻" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Power Grid HaYTooL - Komut Satırı (CLI) Kılavuzu" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Oyun başlatıcıları, Stream Deck, kısayol veya betikleriniz için komutları tek tıkla panoya kopyalayın." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Interactive Generator: Quick Apply Command by Selected Plan -->
        <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtQuickGenTitle" Text="⚡ Hızlı Plan Geçiş Komutu Oluşturucu" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,6"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbPlans" Grid.Column="0" Height="30" VerticalContentAlignment="Center" 
                              Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushInputText}" 
                              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                              SelectionChanged="CmbPlans_SelectionChanged" Margin="0,0,8,0"/>

                    <Button x:Name="BtnCopyQuickApply" Grid.Column="1" Style="{StaticResource PrimaryBtn}" Height="30" Padding="12,0" Click="BtnCopyQuickApply_Click" Content="📋 Plan Komutunu Kopyala"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Commands Scroll List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel x:Name="PnlCommands" Orientation="Vertical">
                <!-- Command Item 1: Smart ON -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GPU OTOMASYON" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="Akıllı GPU Güç Anahtarını Açar" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="GPU yüküne göre 3 kademede otomatik geçişi başlatır. Uygulama kapalıysa arka planda (tepside) sessizce çalıştırır." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,8,0">
                            <TextBlock Text="PowerGridHaYTooL.exe -smart on" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyBtn}" VerticalAlignment="Center" Margin="0,6,0,0" Tag="PowerGridHaYTooL.exe -smart on" Click="BtnCopyCommand_Click" Content="📋 Kopyala"/>
                    </Grid>
                </Border>

                <!-- Command Item 2: Smart OFF -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#EF4444" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GPU OTOMASYON" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="Akıllı GPU Güç Anahtarını Kapatır" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Arka plandaki GPU izlemesini durdurur veya uygulama kapalıysa ayarı kapalı olarak kaydeder." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,8,0">
                            <TextBlock Text="PowerGridHaYTooL.exe -smart off" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyBtn}" VerticalAlignment="Center" Margin="0,6,0,0" Tag="PowerGridHaYTooL.exe -smart off" Click="BtnCopyCommand_Click" Content="📋 Kopyala"/>
                    </Grid>
                </Border>

                <!-- Command Item 3: Smart TOGGLE -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GPU OTOMASYON" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="Akıllı Anahtar Durumunu Değiştirir (Aç/Kapat)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Anahtar açıksa kapatır; kapalıysa açıp arka planda GPU takibini başlatır (Stream Deck / tek tuş için idealdir)." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,8,0">
                            <TextBlock Text="PowerGridHaYTooL.exe -smart toggle" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyBtn}" VerticalAlignment="Center" Margin="0,6,0,0" Tag="PowerGridHaYTooL.exe -smart toggle" Click="BtnCopyCommand_Click" Content="📋 Kopyala"/>
                    </Grid>
                </Border>

                <!-- Command Item 4: Smart STATUS -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#8B5CF6" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="BİLGİ &amp; KONTROL" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="Uygulama ve Akıllı Anahtar Durumunu Gösterir" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Uygulamanın açık olup olmadığını, anahtarın durumunu ve aktif güç planını konsola yazar." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,8,0">
                            <TextBlock Text="PowerGridHaYTooL.exe -smart status" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyBtn}" VerticalAlignment="Center" Margin="0,6,0,0" Tag="PowerGridHaYTooL.exe -smart status" Click="BtnCopyCommand_Click" Content="📋 Kopyala"/>
                    </Grid>
                </Border>

                <!-- Command Item 5: List Plans -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#06B6D4" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GÜÇ DÜZENLERİ" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="Tüm Güç Planlarını ve GUID Kodlarını Listeler" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Sistemdeki tüm Windows güç planlarını, simgelerini ve benzersiz GUID kodlarını konsola döker." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,8,0">
                            <TextBlock Text="PowerGridHaYTooL.exe -list" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyBtn}" VerticalAlignment="Center" Margin="0,6,0,0" Tag="PowerGridHaYTooL.exe -list" Click="BtnCopyCommand_Click" Content="📋 Kopyala"/>
                    </Grid>
                </Border>

                <!-- Command Item 6: Apply Plan -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#F59E0B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GEÇİŞ YAP" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="Belirli Bir Güç Planına Sessizce Geçer" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Pencere açmadan belirtilen GUID kodlu güç planını arka planda anında etkinleştirir." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,8,0">
                            <TextBlock Text="PowerGridHaYTooL.exe -apply {GUID}" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyBtn}" VerticalAlignment="Center" Margin="0,6,0,0" Tag="PowerGridHaYTooL.exe -apply {GUID}" Click="BtnCopyCommand_Click" Content="📋 Kopyala"/>
                    </Grid>
                </Border>

                <!-- Command Item 7: Exit App -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#64748B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="SİSTEM" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="Arka Plandaki Uygulamayı Tamamen Kapatır" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Sistem tepsisinde veya arka planda çalışan Power Grid HaYTooL uygulamasını güvenle sonlandırır." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,6,8,0">
                            <TextBlock Text="PowerGridHaYTooL.exe -exit" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CopyBtn}" VerticalAlignment="Center" Margin="0,6,0,0" Tag="PowerGridHaYTooL.exe -exit" Click="BtnCopyCommand_Click" Content="📋 Kopyala"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Footer -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <TextBlock x:Name="TxtFooterHint" Text="💡 İpucu: Parametrelerin başında - veya / kullanabilirsiniz (Örn: -smart on veya /smart on)." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                <Button x:Name="BtnClose" Style="{StaticResource ModernBtn}" HorizontalAlignment="Right" Width="90" Height="30" Click="BtnClose_Click" Content="Kapat"/>
            </Grid>
        </Border>
    </Grid>
</Window>
