<Window x:Class="PowerGridHaYTooL.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Grid HaYTooL - Hakkında" 
        Height="540" Width="520" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}" 
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="12"
        Icon="pack://application:,,,/logo.png">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style TargetType="{x:Type Button}" x:Key="ModernBtn">
            <Setter Property="Background" Value="{DynamicResource BrushBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushBtnHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushListItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="PrimaryBtn" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#090D16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="LinkCardBtn" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- App Header & Logo -->
            <RowDefinition Height="*"/>    <!-- Links & Info Cards -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logo Icon -->
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/logo.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                </Border>

                <!-- App Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Power Grid HaYTooL" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionBadge" Text="v8.1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="HaYTooL Portalı Resmi Masaüstü Güç Yöneticisi" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Links and Details Stack -->
        <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="TxtDesc" Text="Windows güç planlarını tek tıkla değiştiren, masaüstü sağ tık entegrasyonu sunan ve akıllı GPU/süreç optimizasyonu sağlayan hafif masaüstü güç yöneticisi." 
                               TextWrapping="Wrap" LineHeight="18" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12"/>

                    <Separator Margin="0,0,0,12"/>

                    <!-- Official Website Link Card -->
                    <Border Background="{DynamicResource BrushListBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🌐" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblWebSite" Text="Resmi Web Sitesi" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="haytokoraz.github.io/Power-Grid" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BtnOpenWebsite" Content="Aç ↗" Style="{StaticResource ModernBtn}" Click="BtnOpenWebsite_Click" Padding="10,4" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- GitHub Repository Link Card -->
                    <Border Background="{DynamicResource BrushListBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🐙" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblGithub" Text="GitHub Deposu (Açık Kaynak)" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="github.com/HaYToKoRaZ/Power-Grid" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BtnOpenGithub" Content="Aç ↗" Style="{StaticResource ModernBtn}" Click="BtnOpenGithub_Click" Padding="10,4" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- HaYTooL Portal Link Card -->
                    <Border Background="{DynamicResource BrushListBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🏛️" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblPortal" Text="HaYTooL Portalı" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="haytokoraz.github.io" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BtnOpenPortal" Content="Aç ↗" Style="{StaticResource ModernBtn}" Click="BtnOpenPortal_Click" Padding="10,4" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Contact & Developer Email Card -->
                    <Border Background="{DynamicResource BrushListBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="✉️" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LblMail" Text="İletişim &amp; Destek" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="korazhayto@gmail.com" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BtnCopyEmail" Content="📋 Kopyala" Style="{StaticResource ModernBtn}" Click="BtnCopyEmail_Click" Padding="10,4" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Feedback Button -->
            <Button Grid.Column="0" x:Name="BtnSendFeedback" Click="BtnSendFeedback_Click" Style="{StaticResource PrimaryBtn}" Height="34" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💬" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtFeedbackBtn" Text="Geri Bildirim Gönder (E-Posta)" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Close Button -->
            <Button Grid.Column="2" x:Name="BtnClose" Click="BtnClose_Click" Content="Kapat" Style="{StaticResource ModernBtn}" Width="90" Height="34"/>
        </Grid>
    </Grid>
</Window>
