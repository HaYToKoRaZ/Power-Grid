<Window x:Class="PowerGridHaYTooL.UI.SmartAutoSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎮 Akıllı GPU Kullanımı Otomatik Güç Anahtarı" 
        Width="670" Height="760"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBg}" 
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="12.5"
        Icon="pack://application:,,,/logo.png"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="{x:Type Button}" x:Key="ModernBtn">
            <Setter Property="Background" Value="{DynamicResource BrushBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushBtnHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushListItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="PrimaryBtn" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#090D16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Live Telemetry Card -->
            <RowDefinition Height="*"/>    <!-- 3-Tier Settings Form -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header Card -->
        <Border Grid.Row="0" Margin="0,0,0,10" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushHeaderBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎮" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="3 Kademeli Akıllı GPU Güç Anahtarı" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="TxtSubTitle" Text="GPU yüküne göre (%0-10 Boşta, %10-30 Orta, %30-100 Yüksek) 3 ayrı güç planı arasında otomatik geçiş yapar." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtTip" Text="💡 Arka planda kesintisiz izleme için Sistem Tepsisi (Tray) modu kullanılır." FontSize="10.5" Foreground="{DynamicResource BrushAccent}" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="2" x:Name="ChkEnableService" Content="Aktif" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource BrushAccent}"/>
            </Grid>
        </Border>

        <!-- 2. Live Telemetry Card -->
        <Border Grid.Row="1" Margin="0,0,0,10" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtLiveHeader" Text="⚡ Canlı GPU Telemetrisi &amp; Aktif Kademe" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushAccent}"/>
                        <Border x:Name="BdLiveTierBadge" Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLiveTierBadge" Text="1. Kademe: Düşük" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtLiveStatusMessage" Text="İzleniyor..." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                </Grid>

                <!-- Usage Progress Bar -->
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtForegroundGpuLabel" Text="Ön Plan GPU Kullanımı:" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <ProgressBar Grid.Column="1" x:Name="PrgGpu3D" Height="10" Value="0" Maximum="100" Margin="4,0" Background="{DynamicResource BrushWindowBg}" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Grid.Column="2" x:Name="TxtGpu3DVal" Text="0%" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}"/>
                </Grid>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtForegroundAppLabel" Text="Ön Plan Süreci: " FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock x:Name="TxtForegroundApp" Text="Masaüstü" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text=" • " Foreground="{DynamicResource BrushTextSecondary}" Margin="6,0"/>
                        <TextBlock x:Name="TxtLiveHzLabel" Text="Ekran: " FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock x:Name="TxtLiveHzVal" Text="60 Hz" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrentPlanLabel" Text="Mevcut Güç Planı: " FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock x:Name="TxtCurrentPlanVal" Text="Dengeli" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Settings Form Card (3 Tiers & Sliders) -->
        <Border Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <StackPanel>
                <!-- Hz Otomatik Değiştirme Seçeneği -->
                <Border Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖥️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHzSwitchLabel" Text="Kademelere Göre Monitör Yenileme Hızını (Hz) Otomatik Değiştir" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkEnableHzSwitch" Content="Aktif" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Checked="ChkEnableHzSwitch_CheckedChanged" Unchecked="ChkEnableHzSwitch_CheckedChanged"/>
                    </Grid>
                </Border>

                <!-- KADEME 1: Düşük / Boşta (%0 - %10) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌱" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLowPlanLabel" Text="1. Kademe: Boşta / Düşük Kullanım Planı" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtLowRangeLabel" Text="[%0 - %10]" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="145"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbLowPlan" DisplayMemberPath="Name" SelectedValuePath="Guid" Height="28"/>
                    <ComboBox Grid.Column="2" x:Name="CmbLowHz" DisplayMemberPath="Display" SelectedValuePath="Hz" Height="28"/>
                </Grid>

                <!-- KADEME 2: Orta Kullanım (%10 - %30) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚖️" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMediumPlanLabel" Text="2. Kademe: Standart / Orta Seviye Plan" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtMediumRangeLabel" Text="[%10 - %30]" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="145"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbMediumPlan" DisplayMemberPath="Name" SelectedValuePath="Guid" Height="28"/>
                    <ComboBox Grid.Column="2" x:Name="CmbMediumHz" DisplayMemberPath="Display" SelectedValuePath="Hz" Height="28"/>
                </Grid>

                <!-- KADEME 3: Yüksek Kullanım (%30 - %100) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHighPlanLabel" Text="3. Kademe: Yüksek GPU / Oyun Güç Planı" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtHighRangeLabel" Text="[%30 - %100]" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="145"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbHighPlan" DisplayMemberPath="Name" SelectedValuePath="Guid" Height="28"/>
                    <ComboBox Grid.Column="2" x:Name="CmbHighHz" DisplayMemberPath="Display" SelectedValuePath="Hz" Height="28"/>
                </Grid>

                <Separator Margin="0,0,0,8"/>

                <!-- Eşik Sliderları Yan Yana -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Eşik 1: Düşük -> Orta Geçiş Eşiği -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSldLowLabel" Text="1-2. Kademe Eşiği:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtValLowThreshold" Text="%10" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}"/>
                        </Grid>
                        <Slider x:Name="SldLowThreshold" Minimum="5" Maximum="25" Value="10" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Thresholds_ValueChanged"/>
                    </StackPanel>

                    <!-- Eşik 2: Orta -> Yüksek Geçiş Eşiği -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSldHighLabel" Text="2-3. Kademe Eşiği:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtValHighThreshold" Text="%30" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}"/>
                        </Grid>
                        <Slider x:Name="SldHighThreshold" Minimum="20" Maximum="70" Value="30" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Thresholds_ValueChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Süre Sliderları Yan Yana -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tetiklenme Süresi -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSldTriggerLabel" Text="⏱️ Yükselme Gecikmesi:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtTriggerLabel" Text="3 sn" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}"/>
                        </Grid>
                        <Slider x:Name="SldTriggerSeconds" Minimum="1" Maximum="10" Value="3" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SldTriggerSeconds_ValueChanged"/>
                    </StackPanel>

                    <!-- Geri Dönüş Süresi -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSldRevertLabel" Text="⏳ Düşme Gecikmesi:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Grid.Column="1" x:Name="TxtRevertLabel" Text="6 sn" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushAccent}"/>
                        </Grid>
                        <Slider x:Name="SldRevertSeconds" Minimum="2" Maximum="20" Value="6" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SldRevertSeconds_ValueChanged"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,8"/>

                <!-- Checkbox -->
                <CheckBox x:Name="ChkNotification" Content="Güç Planı Değiştiğinde Bildirim Göster ve Ses Çal" IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- 4. Action Buttons -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnReset" Grid.Column="0" Content="Varsayılanlara Sıfırla" Style="{StaticResource ModernBtn}" Click="BtnReset_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnClose" Content="Kapat" Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="BtnClose_Click"/>
                <Button x:Name="BtnSave" Content="Kaydet ve Uygula" Style="{StaticResource PrimaryBtn}" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
